#!/bin/bash
set -e

echo "=== STOP kubelet + containerd (if running) ==="
sudo systemctl stop kubelet || true
sudo systemctl stop containerd || true

echo "=== kubeadm reset ==="
sudo kubeadm reset -f || true

echo "=== Clean old CNI, kubeconfig, etcd data ==="
sudo rm -rf /etc/cni/net.d
sudo rm -rf $HOME/.kube
sudo rm -rf /var/lib/etcd/*

echo "=== Make sure no control-plane ports are in use ==="
for p in 6443 10250 10259 2379 2380; do
  sudo fuser -k ${p}/tcp || true
done

echo "=== Install containerd (container runtime) ==="
sudo apt-get update
sudo apt-get install -y containerd

echo "=== Configure containerd with systemd cgroup ==="
sudo mkdir -p /etc/containerd
sudo containerd config default | sudo tee /etc/containerd/config.toml >/dev/null
sudo sed -i 's/SystemdCgroup = false/SystemdCgroup = true/' /etc/containerd/config.toml

echo "=== Enable + restart containerd ==="
sudo systemctl enable containerd
sudo systemctl restart containerd

echo "=== Kernel modules for Kubernetes ==="
sudo modprobe br_netfilter
sudo modprobe overlay
cat <<EOF | sudo tee /etc/modules-load.d/k8s.conf >/dev/null
overlay
br_netfilter
EOF

echo "=== Sysctl settings for Kubernetes ==="
cat <<EOF | sudo tee /etc/sysctl.d/k8s.conf >/dev/null
net.bridge.bridge-nf-call-iptables  = 1
net.bridge.bridge-nf-call-ip6tables = 1
net.ipv4.ip_forward                 = 1
EOF
sudo sysctl --system

echo "=== Disable swap ==="
sudo swapoff -a
sudo sed -i '/ swap / s/^\(.*\)$/#\1/' /etc/fstab

echo "=== Start kubelet ==="
sudo systemctl enable kubelet || true
sudo systemctl start kubelet || true

echo "=== NOW RUN kubeadm init MANUALLY AS NEXT STEP ==="
echo "sudo kubeadm init --kubernetes-version=v1.28.1 --pod-network-cidr=10.244.0.0/16"


